<%- include('../partials/layout-start') %>

<div class="page-header">
  <div class="page-header-title">
    <h1>Analytics</h1>
    <p><%= scope %> &middot; ticket performance, workload, SLA compliance, and customer satisfaction.</p>
  </div>
  <% if (currentUser.role === 'admin' && allTeams.length) { %>
    <div class="page-header-actions">
      <form method="GET" class="flex gap-sm">
        <select name="teamId" class="filter-select auto-submit">
          <option value="">All teams</option>
          <% allTeams.forEach(function(t) { %><option value="<%= t.id %>" <%= teamId === t.id ? 'selected' : '' %>><%= t.name %></option><% }) %>
        </select>
      </form>
    </div>
  <% } %>
</div>

<div class="stat-grid">
  <div class="stat-card is-accent-neutral">
    <div class="stat-card-top"><span class="stat-card-label">Total tickets</span></div>
    <div class="stat-card-value"><%= stats.total %></div>
  </div>
  <div class="stat-card is-accent-danger">
    <div class="stat-card-top"><span class="stat-card-label">SLA breaches</span></div>
    <div class="stat-card-value"><%= slaCounts.responseBreached + slaCounts.resolutionBreached %></div>
  </div>
  <div class="stat-card is-accent-success">
    <div class="stat-card-top"><span class="stat-card-label">Avg. resolution time</span></div>
    <div class="stat-card-value"><%= stats.avgResolutionHours !== null ? (stats.avgResolutionHours < 48 ? Math.round(stats.avgResolutionHours) + 'h' : (stats.avgResolutionHours / 24).toFixed(1) + 'd') : '—' %></div>
  </div>
  <div class="stat-card is-accent-neutral">
    <div class="stat-card-top"><span class="stat-card-label">Customer satisfaction</span></div>
    <div class="stat-card-value"><%= ratingStats.average !== null ? ratingStats.average + ' / 5' : '—' %></div>
    <div class="stat-card-meta"><%= ratingStats.total %> ratings</div>
  </div>
</div>

<div class="card mb-lg">
  <div class="card-header"><h3>Tickets Over Time (30 days)</h3></div>
  <div class="chart-card-body"><div id="trendChart" data-chart-title="Tickets created over the last 30 days"></div></div>
</div>

<div class="charts-grid is-triple">
  <div class="card">
    <div class="card-header"><h3>Tickets by Status</h3></div>
    <div class="chart-card-body"><div id="statusChart" data-chart-title="Tickets by status"></div></div>
  </div>
  <div class="card">
    <div class="card-header"><h3>Tickets by Priority</h3></div>
    <div class="chart-card-body"><div id="priorityChart" data-chart-title="Tickets by priority"></div></div>
  </div>
  <div class="card">
    <div class="card-header"><h3>Tickets by Category</h3></div>
    <div class="chart-card-body"><div id="categoryChart" data-chart-title="Tickets by category"></div></div>
  </div>
</div>

<div class="charts-grid">
  <div class="card">
    <div class="card-header"><h3>Agent Workload</h3></div>
    <div class="chart-card-body"><div id="workloadChart" data-chart-title="Open tickets per agent"></div></div>
  </div>
  <div class="card">
    <div class="card-header"><h3>SLA Performance</h3></div>
    <div class="chart-card-body"><div id="slaChart" data-chart-title="SLA response and resolution performance"></div></div>
  </div>
</div>

<div class="card">
  <div class="card-header"><h3>Customer Satisfaction Distribution</h3></div>
  <div class="card-body">
    <% if (ratingStats.total === 0) { %>
      <p class="text-muted">No ratings yet.</p>
    <% } else { %>
      <% [5,4,3,2,1].forEach(function(star) { %>
        <div class="bar-chart-row" style="grid-template-columns: 60px 1fr 40px;">
          <span class="bar-chart-label"><%= star %> star<%= star === 1 ? '' : 's' %></span>
          <div class="bar-chart-track"><div class="bar-chart-fill" style="width: <%= ratingStats.total ? Math.max(3, Math.round((ratingStats.distribution[star] / ratingStats.total) * 100)) : 0 %>%"></div></div>
          <span class="bar-chart-value"><%= ratingStats.distribution[star] %></span>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>

<script type="application/json" data-chart-for="trendChart"><%- jsonScript(trendChart) %></script>
<script type="application/json" data-chart-for="statusChart"><%- jsonScript(statusChart) %></script>
<script type="application/json" data-chart-for="priorityChart"><%- jsonScript(priorityChart) %></script>
<script type="application/json" data-chart-for="categoryChart"><%- jsonScript(categoryChart) %></script>
<script type="application/json" data-chart-for="workloadChart"><%- jsonScript(workloadChart) %></script>
<script type="application/json" data-chart-for="slaChart"><%- jsonScript(slaChart) %></script>

<%- include('../partials/layout-end', { pageScripts }) %>
