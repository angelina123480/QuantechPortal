<%- include('../partials/layout-start') %>

<div class="page-header">
  <div class="page-header-title">
    <h1>Projects</h1>
    <p>IT implementation and service engagements across QuanTech's enterprise clients.</p>
  </div>
  <% if (isManager) { %>
    <div class="page-header-actions">
      <a href="/projects/new" class="btn btn-primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        New Project
      </a>
    </div>
  <% } %>
</div>

<form class="table-toolbar" id="projectFilterForm" method="GET">
  <div class="table-search">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input type="search" name="q" placeholder="Search by name or company..." value="<%= query.q || '' %>">
  </div>
  <select name="status" class="filter-select auto-submit">
    <option value="">All statuses</option>
    <% statuses.forEach(function(s) { %><option value="<%= s %>" <%= query.status === s ? 'selected' : '' %>><%= s %></option><% }) %>
  </select>
  <select name="priority" class="filter-select auto-submit">
    <option value="">All priorities</option>
    <% priorities.forEach(function(p) { %><option value="<%= p %>" <%= query.priority === p ? 'selected' : '' %>><%= p %></option><% }) %>
  </select>
  <button type="submit" class="btn btn-secondary">Search</button>
</form>

<div class="table-wrap">
  <table class="data-table is-stackable" id="projectsTable">
    <thead>
      <tr>
        <th>Name</th>
        <th>Company</th>
        <th>Team</th>
        <th>Status</th>
        <th>Priority</th>
        <th>Progress</th>
        <th>Expected completion</th>
      </tr>
    </thead>
    <tbody>
      <% projects.forEach(function(project) { %>
        <tr class="is-clickable" data-href="/projects/<%= project.id %>">
          <td data-label="Name"><a href="/projects/<%= project.id %>" class="ticket-title-link"><%= project.name %></a></td>
          <td data-label="Company"><%= project.company %></td>
          <td data-label="Team"><%= project.teamId ? (teamNamesById[project.teamId] || '—') : '—' %></td>
          <td data-label="Status"><%- include('../partials/status-badge', { status: project.status }) %></td>
          <td data-label="Priority"><%- include('../partials/priority-badge', { priority: project.priority }) %></td>
          <td data-label="Progress">
            <div class="progress-bar"><div class="progress-bar-fill" style="width: <%= project.progress %>%;"></div></div>
            <span class="progress-bar-label"><%= project.progress %>%</span>
          </td>
          <td data-label="Expected completion"><%= project.expectedCompletionDate ? new Date(project.expectedCompletionDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '—' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <div class="table-empty-state" id="projectsEmptyState" <%= projects.length ? 'hidden' : '' %>>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/></svg>
    <p><%= projects.length ? 'No projects match your filters.' : 'No projects yet.' %></p>
  </div>
</div>
<div class="flex justify-between items-center mt-sm">
  <p class="table-row-count"><%= total %> project<%= total === 1 ? '' : 's' %> total &middot; page <%= page %> of <%= totalPages %></p>
  <% if (totalPages > 1) { %>
    <div class="flex gap-sm">
      <% if (page > 1) { %><a class="btn btn-secondary btn-sm" href="?<%= new URLSearchParams(Object.assign({}, query, { page: page - 1 })).toString() %>">Previous</a><% } %>
      <% if (page < totalPages) { %><a class="btn btn-secondary btn-sm" href="?<%= new URLSearchParams(Object.assign({}, query, { page: page + 1 })).toString() %>">Next</a><% } %>
    </div>
  <% } %>
</div>

<%- include('../partials/layout-end', { pageScripts: ['projects'] }) %>
