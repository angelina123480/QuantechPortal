<%- include('../partials/layout-start') %>

<% var statusIndex = statuses.indexOf(ticket.status); %>

<% if (justCreated) { %>
  <div class="confirmation-banner">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/></svg>
    <div>
      <strong>Ticket <%= ticket.ticketNumber %> was submitted successfully.</strong>
      <span>QuanTech's support team has been notified and will triage it shortly.</span>
    </div>
  </div>
<% } %>

<div class="ticket-detail-header">
  <div class="ticket-detail-heading">
    <span class="ticket-number">
      <%= ticket.ticketNumber %>
      <% if (ticket.isOverdue) { %> &middot; <span class="badge badge-overdue">Overdue</span><% } %>
    </span>
    <h1><%= ticket.title %></h1>
    <div class="ticket-detail-badges">
      <%- include('../partials/priority-badge', { priority: ticket.priority }) %>
      <%- include('../partials/status-badge', { status: ticket.status }) %>
      <span class="badge badge-neutral"><%= ticket.category %></span>
      <% if (ticket.isArchived) { %><span class="badge badge-neutral">Archived</span><% } %>
    </div>
  </div>
  <% if (!isStaff) { %>
    <div class="page-header-actions">
      <% if (ticket.status === 'Resolved' && !ticket.isArchived) { %>
        <form action="/tickets/<%= ticket.id %>/close" method="POST" class="js-confirm" data-confirm="Close this ticket? You can reopen it later if the issue persists.">
          <button type="submit" class="btn btn-primary">Close Ticket</button>
        </form>
      <% } %>
      <% if (['Resolved', 'Closed'].includes(ticket.status) && !ticket.isArchived) { %>
        <form action="/tickets/<%= ticket.id %>/reopen" method="POST" class="js-confirm" data-confirm="Reopen this ticket? QuanTech will be notified.">
          <button type="submit" class="btn btn-secondary">Reopen Ticket</button>
        </form>
        <form action="/tickets/<%= ticket.id %>/archive" method="POST" class="js-confirm" data-confirm="Archive this ticket? You can find it later under Archived Tickets.">
          <button type="submit" class="btn btn-secondary">Archive Ticket</button>
        </form>
      <% } %>
    </div>
  <% } else { %>
    <div class="page-header-actions">
      <% if (!['Escalated', 'Resolved', 'Closed'].includes(ticket.status)) { %>
        <form action="/tickets/<%= ticket.id %>/escalate" method="POST" class="js-confirm" data-confirm="Escalate this ticket to the team leader?">
          <button type="submit" class="btn btn-secondary">Escalate</button>
        </form>
      <% } %>
      <% if (ticket.isArchived) { %>
        <form action="/tickets/<%= ticket.id %>/restore" method="POST" class="js-confirm" data-confirm="Restore this ticket back to the active workspace?">
          <button type="submit" class="btn btn-secondary">Restore Ticket</button>
        </form>
      <% } else if (['Resolved', 'Closed'].includes(ticket.status)) { %>
        <form action="/tickets/<%= ticket.id %>/archive" method="POST" class="js-confirm" data-confirm="Archive this ticket? It will move out of the active ticket list.">
          <button type="submit" class="btn btn-secondary">Archive Ticket</button>
        </form>
      <% } %>
      <button type="button" class="btn btn-ghost" data-modal-target="linkTicketModal">Link / Merge</button>
    </div>
  <% } %>
</div>

<% if (isStaff) { %>
<div class="modal-overlay" id="linkTicketModal">
  <div class="modal">
    <div class="modal-header">
      <h3>Link or merge a ticket</h3>
      <button type="button" class="modal-close" data-modal-close aria-label="Close">&times;</button>
    </div>
    <form action="/tickets/<%= ticket.id %>/link" method="POST" class="modal-body flex-col gap-md">
      <div class="form-group">
        <label for="ticketNumber">Other ticket number</label>
        <input type="text" id="ticketNumber" name="ticketNumber" placeholder="e.g. QNT-2026-00123" required>
      </div>
      <div class="form-group">
        <label for="linkType">Relationship</label>
        <select id="linkType" name="linkType">
          <option value="related">Related</option>
          <option value="duplicate">Duplicate (closes this ticket)</option>
          <option value="parent">Parent / larger issue</option>
        </select>
      </div>
      <div class="flex justify-between items-center">
        <button type="button" class="btn btn-ghost" data-modal-close>Cancel</button>
        <button type="submit" class="btn btn-primary">Save link</button>
      </div>
    </form>
  </div>
</div>
<% } %>

<div class="card mb-lg">
  <div class="card-body">
    <div class="status-timeline">
      <% statuses.forEach(function(s, i) { %>
        <div class="status-timeline-step <%= i < statusIndex ? 'is-complete' : (i === statusIndex ? 'is-current' : '') %>">
          <span class="status-timeline-line"></span>
          <span class="status-timeline-dot"><%= i < statusIndex ? '✓' : '' %></span>
          <span class="status-timeline-label"><%= s %></span>
        </div>
      <% }) %>
    </div>
  </div>
</div>

<div class="ticket-detail-grid">
  <div class="flex-col gap-lg">
    <div class="card">
      <div class="card-header"><h3>Description</h3></div>
      <div class="card-body">
        <p class="conversation-message"><%= ticket.description %></p>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><h3>Conversation</h3></div>
      <div class="card-body">
        <div class="conversation-list" id="conversationList">
          <% ticket.history.filter(function(h) { return !h.internal || isStaff; }).forEach(function(item) { %>
            <%- include('../partials/conversation-item', { item }) %>
          <% }) %>
        </div>

        <hr class="divider">

        <form id="replyForm" action="/tickets/<%= ticket.id %>/reply" method="POST" enctype="multipart/form-data" class="reply-box">
          <% if (isStaff && cannedResponses.length) { %>
            <div class="form-group">
              <label for="cannedResponsePicker">Insert canned response <span class="text-muted">(optional)</span></label>
              <select id="cannedResponsePicker" class="filter-select">
                <option value="">Select a canned response&hellip;</option>
                <% cannedResponses.forEach(function(cr) { %>
                  <option value="<%= cr.id %>" data-body="<%= cr.body.replace(/"/g, '&quot;') %>"><%= cr.title %></option>
                <% }) %>
              </select>
            </div>
          <% } %>
          <div class="form-group">
            <label for="message"><%= isStaff ? 'Reply to client' : 'Add a reply' %></label>
            <textarea id="message" name="message" placeholder="<%= isStaff ? 'Write a reply the client will see...' : 'Share additional details or ask a question...' %>"></textarea>
          </div>
          <div class="form-group">
            <label for="replyAttachments">Attach files <span class="text-muted">(optional)</span></label>
            <input type="file" id="replyAttachments" name="attachments" multiple>
          </div>
          <div class="reply-box-footer">
            <% if (isStaff) { %>
              <label class="checkbox-row">
                <input type="checkbox" name="internal">
                Internal note (not visible to client)
              </label>
            <% } else { %>
              <span></span>
            <% } %>
            <button type="submit" class="btn btn-primary">Send Reply</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="flex-col gap-lg">
    <div class="card">
      <div class="card-header"><h3>Ticket Details</h3></div>
      <div class="card-body">
        <div class="meta-list">
          <div class="meta-row">
            <span class="meta-row-label">Category</span>
            <span class="meta-row-value"><%= ticket.category %></span>
          </div>

          <% if (isStaff) { %>
            <div class="meta-row">
              <span class="meta-row-label">Priority</span>
              <form action="/tickets/<%= ticket.id %>/priority" method="POST">
                <select name="priority" class="auto-submit filter-select">
                  <% priorities.forEach(function(p) { %>
                    <option value="<%= p %>" <%= ticket.priority === p ? 'selected' : '' %>><%= p %></option>
                  <% }) %>
                </select>
              </form>
            </div>
            <div class="meta-row">
              <span class="meta-row-label">Status</span>
              <form action="/tickets/<%= ticket.id %>/status" method="POST">
                <select name="status" class="auto-submit filter-select">
                  <% statuses.forEach(function(s) { %>
                    <option value="<%= s %>" <%= ticket.status === s ? 'selected' : '' %>><%= s %></option>
                  <% }) %>
                </select>
              </form>
            </div>
            <div class="meta-row">
              <span class="meta-row-label">Technician</span>
              <form action="/tickets/<%= ticket.id %>/assign" method="POST">
                <select name="technicianId" class="auto-submit filter-select">
                  <option value="">Unassigned</option>
                  <% technicians.forEach(function(t) { %>
                    <option value="<%= t.id %>" <%= ticket.assignedTechnicianId === t.id ? 'selected' : '' %>><%= t.name %></option>
                  <% }) %>
                </select>
              </form>
            </div>
          <% } else { %>
            <div class="meta-row">
              <span class="meta-row-label">Assigned technician</span>
              <span class="meta-row-value">
                <% if (ticket.assignedTechnician) { %>
                  <span class="assignee-row"><span class="avatar is-sm"><%= ticket.assignedTechnician.name.split(' ').map(function(n){return n[0];}).join('') %></span><%= ticket.assignedTechnician.name %></span>
                <% } else { %>Not yet assigned<% } %>
              </span>
            </div>
          <% } %>

          <div class="meta-row">
            <span class="meta-row-label">Affected service</span>
            <span class="meta-row-value"><%= ticket.affectedService %></span>
          </div>
          <div class="meta-row">
            <span class="meta-row-label">Company</span>
            <span class="meta-row-value"><%= ticket.company %></span>
          </div>
          <div class="meta-row">
            <span class="meta-row-label">Department</span>
            <span class="meta-row-value"><%= ticket.clientDepartment %></span>
          </div>
          <div class="meta-row">
            <span class="meta-row-label">Contact</span>
            <span class="meta-row-value"><%= ticket.contactName %></span>
          </div>
          <div class="meta-row">
            <span class="meta-row-label">Contact email</span>
            <span class="meta-row-value"><%= ticket.contactEmail %></span>
          </div>
          <div class="meta-row">
            <span class="meta-row-label">Created</span>
            <span class="meta-row-value"><%= new Date(ticket.createdAt).toLocaleString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
          </div>
          <div class="meta-row">
            <span class="meta-row-label">Last updated</span>
            <span class="meta-row-value"><%= new Date(ticket.updatedAt).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %></span>
          </div>
          <% if (ticket.isArchived) { %>
          <div class="meta-row">
            <span class="meta-row-label">Archived</span>
            <span class="meta-row-value"><%= new Date(ticket.archivedAt).toLocaleString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
          </div>
          <% } %>
          <div class="meta-row">
            <span class="meta-row-label">SLA target</span>
            <span class="meta-row-value">
              <span class="<%= ticket.isOverdue ? 'text-danger' : '' %>"><%= new Date(ticket.dueAt).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %></span>
              <% if (!['Resolved', 'Closed'].includes(ticket.status)) { %>
                <span class="sla-countdown" data-sla-due="<%= ticket.dueAt.toISOString() %>"></span>
              <% } %>
            </span>
          </div>
          <div class="meta-row">
            <span class="meta-row-label">Response SLA</span>
            <span class="meta-row-value">
              <span class="badge <%= slaState.responseStatus === 'breached' ? 'badge-overdue' : (slaState.responseStatus === 'met' ? 'badge-status-resolved' : 'badge-neutral') %>">
                <%= slaState.responseStatus === 'met' ? 'Met' : slaState.responseStatus === 'breached' ? 'Breached' : 'Pending' %>
              </span>
            </span>
          </div>
          <div class="meta-row">
            <span class="meta-row-label">SLA time used</span>
            <span class="meta-row-value sla-percent-value">
              <span class="sla-percent-bar"><span class="sla-percent-bar-fill <%= slaState.resolutionStatus %>" style="width: <%= slaState.resolutionPercentUsed %>%"></span></span>
              <%= slaState.resolutionPercentUsed %>%
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><h3>Attachments</h3></div>
      <div class="card-body">
        <% var visibleAttachments = ticket.attachments.filter(function(f) { return !f.internal || isStaff; }); %>
        <% if (visibleAttachments.length === 0) { %>
          <p class="text-muted">No files attached.</p>
        <% } else { %>
          <% visibleAttachments.forEach(function(file) { %>
            <a href="<%= file.url %>" class="attachment-item" target="_blank" rel="noopener noreferrer">
              <% if (file.mimeType && file.mimeType.startsWith('image/')) { %>
                <img src="<%= file.url %>" alt="" class="attachment-thumb">
              <% } else { %>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
              <% } %>
              <div>
                <div><%= file.originalName %><% if (file.internal) { %> <span class="internal-note-tag">Internal</span><% } %></div>
                <div class="attachment-meta"><%= Math.round(file.size / 1024) %> KB</div>
              </div>
            </a>
          <% }) %>
        <% } %>
      </div>
    </div>

    <% if (ticket.linkedTickets && ticket.linkedTickets.length > 0) { %>
    <div class="card">
      <div class="card-header"><h3>Linked Tickets</h3></div>
      <div class="card-body">
        <% ticket.linkedTickets.forEach(function(l) { %>
          <a href="/tickets/<%= l.ticket.id %>" class="recent-ticket-item">
            <div class="recent-ticket-main">
              <span class="recent-ticket-title"><%= l.ticket.ticketNumber %> &middot; <%= l.ticket.title %></span>
              <div class="recent-ticket-meta"><span class="badge badge-neutral"><%= l.linkType %></span></div>
            </div>
            <%- include('../partials/status-badge', { status: l.ticket.status }) %>
          </a>
        <% }) %>
      </div>
    </div>
    <% } %>

    <% if (!isStaff && ['Resolved', 'Closed'].includes(ticket.status)) { %>
    <div class="card">
      <div class="card-header"><h3>Rate This Support Experience</h3></div>
      <div class="card-body">
        <% if (ticket.rating) { %>
          <div class="star-rating-display">
            <% for (var s = 1; s <= 5; s++) { %><span class="star <%= s <= ticket.rating.stars ? 'is-filled' : '' %>">&#9733;</span><% } %>
          </div>
          <% if (ticket.rating.feedback) { %><p class="text-muted mt-sm">&ldquo;<%= ticket.rating.feedback %>&rdquo;</p><% } %>
          <p class="form-hint">Thanks for your feedback!</p>
        <% } else { %>
          <form action="/tickets/<%= ticket.id %>/rating" method="POST" id="ratingForm">
            <div class="star-rating-input" id="starRatingInput">
              <% for (var s = 5; s >= 1; s--) { %>
                <input type="radio" id="star<%= s %>" name="stars" value="<%= s %>" <%= s === 5 ? 'required' : '' %>>
                <label for="star<%= s %>" title="<%= s %> stars">&#9733;</label>
              <% } %>
            </div>
            <div class="form-group mt-sm">
              <label for="feedback">Feedback <span class="text-muted">(optional)</span></label>
              <textarea id="feedback" name="feedback" placeholder="How did we do?"></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Submit Rating</button>
          </form>
        <% } %>
      </div>
    </div>
    <% } %>
  </div>
</div>

<%- include('../partials/layout-end', { pageScripts: ['ticket-detail', 'sla-countdown'] }) %>
