<%- include('../partials/layout-start') %>

<div class="page-header">
  <div class="page-header-title">
    <h1>Audit Logs</h1>
    <p>Every recorded system action — logins, ticket changes, admin edits, and permission changes.</p>
  </div>
</div>

<div class="table-toolbar">
  <form class="table-search" method="GET">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input type="search" name="q" placeholder="Search by user, action, or entity..." value="<%= query.q || '' %>">
  </form>
  <form method="GET">
    <select name="action" class="filter-select auto-submit">
      <option value="">All actions</option>
      <% actions.forEach(function(a) { %><option value="<%= a %>" <%= query.action === a ? 'selected' : '' %>><%= a %></option><% }) %>
    </select>
  </form>
</div>

<div class="table-wrap">
  <table class="data-table is-stackable">
    <thead><tr><th>When</th><th>User</th><th>Action</th><th>Entity</th><th>Before</th><th>After</th></tr></thead>
    <tbody>
      <% logs.forEach(function(log) { %>
        <tr>
          <td data-label="When"><%= new Date(log.createdAt).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %></td>
          <td data-label="User"><%= log.userName || 'System' %></td>
          <td data-label="Action"><span class="badge badge-neutral"><%= log.action %></span></td>
          <td data-label="Entity"><%= log.entityType ? (log.entityType + ' · ' + (log.entityId || '')) : '—' %></td>
          <td data-label="Before"><code class="mono" style="font-size:11px;"><%= log.beforeValue ? JSON.stringify(log.beforeValue) : '—' %></code></td>
          <td data-label="After"><code class="mono" style="font-size:11px;"><%= log.afterValue ? JSON.stringify(log.afterValue) : '—' %></code></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<% if (totalPages > 1) { %>
<div class="flex justify-between items-center mt-lg">
  <span class="text-muted"><%= total %> total log entries &middot; page <%= page %> of <%= totalPages %></span>
  <div class="flex gap-sm">
    <% if (page > 1) { %><a class="btn btn-secondary btn-sm" href="?<%= new URLSearchParams(Object.assign({}, query, { page: page - 1 })).toString() %>">Previous</a><% } %>
    <% if (page < totalPages) { %><a class="btn btn-secondary btn-sm" href="?<%= new URLSearchParams(Object.assign({}, query, { page: page + 1 })).toString() %>">Next</a><% } %>
  </div>
</div>
<% } %>

<%- include('../partials/layout-end') %>
