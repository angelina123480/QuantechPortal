<%- include('../partials/layout-start') %>

<div class="page-header">
  <div class="page-header-title">
    <h1>Companies</h1>
    <p>Enterprise client organizations QuanTech supports.</p>
  </div>
</div>

<div class="card mb-lg">
  <div class="card-header"><h3>Create Company</h3></div>
  <div class="card-body">
    <% if (errors && errors.form) { %><div class="alert alert-error"><span><%= errors.form %></span></div><% } %>
    <form action="/admin/companies" method="POST" novalidate>
      <div class="form-row">
        <div class="form-group">
          <label for="name">Company name</label>
          <input type="text" id="name" name="name" value="<%= formData.name || '' %>" required>
        </div>
        <div class="form-group">
          <label for="industry">Industry</label>
          <input type="text" id="industry" name="industry" value="<%= formData.industry || '' %>">
        </div>
        <div class="form-group">
          <label for="teamId">Default support team</label>
          <select id="teamId" name="teamId">
            <option value="">None</option>
            <% teams.forEach(function(t) { %><option value="<%= t.id %>"><%= t.name %></option><% }) %>
          </select>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="contactName">Primary contact name</label>
          <input type="text" id="contactName" name="contactName" value="<%= formData.contactName || '' %>">
        </div>
        <div class="form-group">
          <label for="contactEmail">Contact email</label>
          <input type="email" id="contactEmail" name="contactEmail" value="<%= formData.contactEmail || '' %>">
        </div>
        <div class="form-group">
          <label for="contactPhone">Contact phone</label>
          <input type="tel" id="contactPhone" name="contactPhone" value="<%= formData.contactPhone || '' %>">
        </div>
      </div>
      <button type="submit" class="btn btn-primary">Create Company</button>
    </form>
  </div>
</div>

<div class="table-toolbar">
  <form method="GET">
    <select name="status" class="filter-select auto-submit">
      <option value="active" <%= statusFilter === 'active' ? 'selected' : '' %>>Active</option>
      <option value="inactive" <%= statusFilter === 'inactive' ? 'selected' : '' %>>Deactivated</option>
      <option value="all" <%= statusFilter === 'all' ? 'selected' : '' %>>All</option>
    </select>
  </form>
</div>

<div class="table-wrap">
  <table class="data-table is-stackable">
    <thead><tr><th>Company</th><th>Industry</th><th>Contact</th><th>Support Team</th><th>Users</th><th>Sub-clients</th><th>Projects</th><th>Tickets</th><th>Status</th><th>Actions</th></tr></thead>
    <tbody>
      <% companies.forEach(function(c) { %>
        <tr>
          <td data-label="Company"><a href="/admin/companies/<%= encodeURIComponent(c.name) %>" class="ticket-title-link"><%= c.name %></a></td>
          <td data-label="Industry"><%= c.industry || '—' %></td>
          <td data-label="Contact"><%= c.contactName || '—' %><% if (c.contactEmail) { %><br><span class="text-muted"><%= c.contactEmail %></span><% } %></td>
          <td data-label="Support Team"><%= c.teamName || '—' %></td>
          <td data-label="Users"><%= c.userCount %></td>
          <td data-label="Sub-clients"><%= c.subClientCount %></td>
          <td data-label="Projects"><%= c.projectCount %></td>
          <td data-label="Tickets"><%= c.ticketCount %></td>
          <td data-label="Status"><%- include('../partials/status-badge', { status: c.isActive ? 'Active' : 'Deactivated' }) %></td>
          <td data-label="Actions">
            <details>
              <summary class="btn btn-secondary btn-sm">Edit</summary>
              <form action="/admin/companies/<%= encodeURIComponent(c.name) %>" method="POST" class="mt-sm flex-col gap-sm">
                <input type="text" name="name" value="<%= c.name %>" placeholder="Company name">
                <input type="text" name="contactName" value="<%= c.contactName || '' %>" placeholder="Contact name">
                <input type="email" name="contactEmail" value="<%= c.contactEmail || '' %>" placeholder="Contact email">
                <input type="tel" name="contactPhone" value="<%= c.contactPhone || '' %>" placeholder="Contact phone">
                <input type="text" name="industry" value="<%= c.industry || '' %>" placeholder="Industry">
                <select name="teamId">
                  <option value="">No default team</option>
                  <% teams.forEach(function(t) { %><option value="<%= t.id %>" <%= c.teamId === t.id ? 'selected' : '' %>><%= t.name %></option><% }) %>
                </select>
                <button type="submit" class="btn btn-primary btn-sm">Save</button>
              </form>
            </details>
            <form action="/admin/companies/<%= encodeURIComponent(c.name) %>/status" method="POST">
              <input type="hidden" name="active" value="<%= c.isActive ? '0' : '1' %>">
              <button type="submit" class="btn btn-ghost btn-sm"><%= c.isActive ? 'Deactivate' : 'Activate' %></button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/layout-end') %>
