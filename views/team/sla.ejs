<%- include('../partials/layout-start') %>

<div class="page-header">
  <div class="page-header-title">
    <h1>SLA Monitoring</h1>
    <p><%= team ? team.name + ' — open tickets sorted by SLA urgency.' : "You don't currently have a team." %></p>
  </div>
  <% if (isAdmin && allTeams.length) { %>
    <div class="page-header-actions">
      <form method="GET" class="flex gap-sm">
        <select name="teamId" class="filter-select auto-submit">
          <option value="">Select a team&hellip;</option>
          <% allTeams.forEach(function(t) { %><option value="<%= t.id %>" <%= team && team.id === t.id ? 'selected' : '' %>><%= t.name %></option><% }) %>
        </select>
      </form>
    </div>
  <% } %>
</div>

<% if (!team) { %>
  <div class="card"><div class="card-body"><p class="text-muted">No team to monitor yet.</p></div></div>
<% } else if (rows.length === 0) { %>
  <div class="card"><div class="card-body"><p class="text-muted">No open tickets for this team right now.</p></div></div>
<% } else { %>
<div class="table-wrap">
  <table class="data-table is-stackable">
    <thead><tr><th>Ticket</th><th>Priority</th><th>Assigned</th><th>Response SLA</th><th>Resolution SLA used</th><th>Status</th></tr></thead>
    <tbody>
      <% rows.forEach(function(row) { %>
        <tr>
          <td data-label="Ticket"><a href="/tickets/<%= row.ticket.id %>" class="ticket-title-link"><%= row.ticket.ticketNumber %> &middot; <%= row.ticket.title %></a></td>
          <td data-label="Priority"><%- include('../partials/priority-badge', { priority: row.ticket.priority }) %></td>
          <td data-label="Assigned"><%= row.assignedTechnician ? row.assignedTechnician.name : 'Unassigned' %></td>
          <td data-label="Response SLA">
            <span class="badge <%= row.sla.responseStatus === 'breached' ? 'badge-overdue' : (row.sla.responseStatus === 'met' ? 'badge-status-resolved' : 'badge-neutral') %>">
              <%= row.sla.responseStatus === 'met' ? 'Met' : row.sla.responseStatus === 'breached' ? 'Breached' : 'Pending' %>
            </span>
          </td>
          <td data-label="Resolution SLA used">
            <span class="sla-percent-value">
              <span class="sla-percent-bar"><span class="sla-percent-bar-fill <%= row.sla.resolutionStatus %>" style="width: <%= row.sla.resolutionPercentUsed %>%"></span></span>
              <%= row.sla.resolutionPercentUsed %>%
            </span>
          </td>
          <td data-label="Status"><%- include('../partials/status-badge', { status: row.ticket.status }) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>

<%- include('../partials/layout-end') %>
