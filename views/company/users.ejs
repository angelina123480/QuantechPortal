<%- include('../partials/layout-start') %>

<div class="page-header">
  <div class="page-header-title">
    <h1>Users</h1>
    <p>Manage the client users and sub-clients for <%= currentUser.company %>.</p>
  </div>
</div>

<nav class="section-nav" data-section-tabs>
  <a href="#users" class="section-nav-item" data-section-tab="users">Users (<%= users.length %>)</a>
  <a href="#sub-clients" class="section-nav-item" data-section-tab="sub-clients">Sub-clients (<%= subClients.length %>)</a>
</nav>

<div data-section-panel="users">
  <div class="card mb-lg">
    <div class="card-header"><h3>Invite User</h3></div>
    <div class="card-body">
      <% if (errors && errors.form) { %><div class="alert alert-error"><span><%= errors.form %></span></div><% } %>
      <form action="/company/users" method="POST" novalidate>
        <div class="form-row">
          <div class="form-group">
            <label for="name">Full name</label>
            <input type="text" id="name" name="name" value="<%= formData.name || '' %>" required>
          </div>
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" value="<%= formData.email || '' %>" required>
            <span class="text-muted" style="font-size: 12px;">They'll be emailed a link to set their own password.</span>
          </div>
          <div class="form-group">
            <label for="role">Role</label>
            <select id="role" name="role" required>
              <% roles.forEach(function(r) { %><option value="<%= r %>" <%= formData.role === r ? 'selected' : '' %>><%= roleLabels[r] %></option><% }) %>
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="subClientId">Sub-client <span class="text-muted">(End Client Users only)</span></label>
            <select id="subClientId" name="subClientId">
              <option value="">None (whole company)</option>
              <% subClients.forEach(function(s) { %><option value="<%= s.id %>" <%= formData.subClientId === s.id ? 'selected' : '' %>><%= s.name %></option><% }) %>
            </select>
          </div>
          <div class="form-group">
            <label for="department">Department</label>
            <input type="text" id="department" name="department" value="<%= formData.department || '' %>">
          </div>
          <div class="form-group">
            <label for="title">Title</label>
            <input type="text" id="title" name="title" value="<%= formData.title || '' %>">
          </div>
        </div>
        <button type="submit" class="btn btn-primary">Send Invite</button>
      </form>
    </div>
  </div>

  <div class="table-wrap">
    <table class="data-table is-stackable">
      <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Sub-client</th><th>Status</th><th>Actions</th></tr></thead>
      <tbody>
        <% if (users.length === 0) { %>
          <tr><td colspan="6" class="text-muted">No users yet — invite your first one above.</td></tr>
        <% } %>
        <% users.forEach(function(u) { %>
          <tr>
            <td data-label="Name"><a href="/company/users/<%= u.id %>" class="assignee-row"><span class="avatar is-sm"><%= u.name.split(' ').map(function(n){return n[0];}).join('') %></span><%= u.name %></a></td>
            <td data-label="Email"><%= u.email %></td>
            <td data-label="Role"><span class="badge badge-neutral"><%= roleLabels[u.role] %></span></td>
            <td data-label="Sub-client"><% var sc = subClients.find(function(s){return s.id === u.subClientId;}); %><%= sc ? sc.name : '—' %></td>
            <td data-label="Status"><%- include('../partials/status-badge', { status: u.isActive ? 'Active' : 'Deactivated' }) %></td>
            <td data-label="Actions">
              <details>
                <summary class="btn btn-secondary btn-sm">Edit</summary>
                <form action="/company/users/<%= u.id %>" method="POST" class="mt-sm flex-col gap-sm">
                  <input type="text" name="name" value="<%= u.name %>" placeholder="Name">
                  <select name="role">
                    <% roles.forEach(function(r) { %><option value="<%= r %>" <%= u.role === r ? 'selected' : '' %>><%= roleLabels[r] %></option><% }) %>
                  </select>
                  <select name="subClientId">
                    <option value="">No sub-client (whole company)</option>
                    <% subClients.forEach(function(s) { %><option value="<%= s.id %>" <%= u.subClientId === s.id ? 'selected' : '' %>><%= s.name %></option><% }) %>
                  </select>
                  <input type="text" name="department" value="<%= u.department || '' %>" placeholder="Department">
                  <input type="text" name="title" value="<%= u.title || '' %>" placeholder="Title">
                  <input type="hidden" name="isActive" value="<%= u.isActive ? 'on' : '' %>">
                  <button type="submit" class="btn btn-primary btn-sm">Save</button>
                </form>
              </details>
              <form action="/company/users/<%= u.id %>/status" method="POST">
                <input type="hidden" name="active" value="<%= u.isActive ? '0' : '1' %>">
                <input type="hidden" name="returnTo" value="/company/users">
                <button type="submit" class="btn btn-ghost btn-sm"><%= u.isActive ? 'Deactivate' : 'Activate' %></button>
              </form>
              <form action="/company/users/<%= u.id %>/resend-invite" method="POST" onsubmit="return confirm('Send a password link to this user?');">
                <input type="hidden" name="returnTo" value="/company/users">
                <button type="submit" class="btn btn-ghost btn-sm">Resend Invite</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div data-section-panel="sub-clients" hidden>
  <div class="card">
    <div class="card-header"><h3>Sub-clients (<%= subClients.length %>)</h3></div>
    <div class="card-body">
      <% if (subClients.length === 0) { %>
        <p class="text-muted">No sub-clients yet — add one below for a branch or department that needs its own scoped view.</p>
      <% } %>
      <% subClients.forEach(function(s) { %>
        <div class="recent-ticket-item" style="flex-wrap: wrap;">
          <div class="recent-ticket-main">
            <span class="recent-ticket-title"><%= s.name %></span>
            <div class="recent-ticket-meta">
              <span><%= s.contactName || 'No contact set' %></span><% if (s.contactEmail) { %><span>&middot;</span><span><%= s.contactEmail %></span><% } %>
              <%- include('../partials/status-badge', { status: s.isActive ? 'Active' : 'Deactivated' }) %>
            </div>
          </div>
          <details>
            <summary class="btn btn-ghost btn-sm">Edit</summary>
            <form action="/company/sub-clients/<%= s.id %>" method="POST" class="mt-sm flex-col gap-sm">
              <input type="text" name="name" value="<%= s.name %>" required>
              <input type="text" name="contactName" value="<%= s.contactName || '' %>" placeholder="Contact name">
              <input type="email" name="contactEmail" value="<%= s.contactEmail || '' %>" placeholder="Contact email">
              <input type="tel" name="contactPhone" value="<%= s.contactPhone || '' %>" placeholder="Contact phone">
              <button type="submit" class="btn btn-primary btn-sm">Save</button>
            </form>
          </details>
          <form action="/company/sub-clients/<%= s.id %>/status" method="POST">
            <input type="hidden" name="active" value="<%= s.isActive ? '0' : '1' %>">
            <button type="submit" class="btn btn-ghost btn-sm"><%= s.isActive ? 'Deactivate' : 'Activate' %></button>
          </form>
        </div>
      <% }) %>
      <form action="/company/sub-clients" method="POST" class="mt-md flex-col gap-sm" style="max-width: 420px;">
        <input type="text" name="name" placeholder="Sub-client name (e.g. Beirut Branch)" required>
        <input type="text" name="contactName" placeholder="Contact name">
        <input type="email" name="contactEmail" placeholder="Contact email">
        <input type="tel" name="contactPhone" placeholder="Contact phone">
        <button type="submit" class="btn btn-secondary btn-sm">Add Sub-client</button>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/layout-end') %>
