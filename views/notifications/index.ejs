<%- include('../partials/layout-start') %>

<div class="page-header">
  <div class="page-header-title">
    <h1>Notifications</h1>
    <p>Every ticket event relevant to you, most recent first.</p>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <% if (notifications.length === 0) { %>
      <p class="text-muted">You're all caught up — no notifications yet.</p>
    <% } else { %>
      <% notifications.forEach(function(n) { %>
        <div class="notification-row <%= !n.isRead ? 'is-unread' : '' %>">
          <a href="<%= n.ticketId ? '/tickets/' + n.ticketId : '#' %>" class="notification-row-link">
            <div class="notification-row-main">
              <div class="notification-row-title"><%= n.title %></div>
              <% if (n.body) { %><div class="notification-row-body"><%= n.body %></div><% } %>
            </div>
            <div class="notification-row-time"><%= new Date(n.createdAt).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %></div>
          </a>
          <% if (n.isRead) { %>
            <form action="/notifications/<%= n.id %>/delete" method="POST" class="notification-row-delete-form">
              <button type="submit" class="notification-row-delete" aria-label="Remove notification">&times;</button>
            </form>
          <% } %>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>

<%- include('../partials/layout-end') %>
