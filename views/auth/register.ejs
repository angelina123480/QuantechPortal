<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head') %>
</head>
<body>
<div class="auth-shell">
  <div class="auth-brand-panel">
    <div class="auth-brand-top">
      <div class="auth-brand-mark"><%- include('../partials/logo', { size: 40 }) %></div>
      <div>
        <div class="auth-brand-name">QuanTech</div>
        <div class="auth-brand-sub">Enterprise Support Portal</div>
      </div>
    </div>
    <div class="auth-brand-mid">
      <h1>Create your client account.</h1>
      <p>Register to submit and track support tickets for your organization.</p>
    </div>
    <div class="auth-brand-bottom">QuanTech SAL &middot; Midis Group &middot; Est. 1995</div>
  </div>

  <div class="auth-form-panel">
    <div class="auth-card">
      <h2>Create account</h2>
      <p class="lead">Client accounts only — QuanTech staff accounts are provisioned by an administrator.</p>

      <form action="/register" method="POST" novalidate>
        <div class="form-row">
          <div class="form-group <%= errors && errors.name ? 'field-invalid' : '' %>">
            <label for="name">Full name</label>
            <input type="text" id="name" name="name" value="<%= formData.name || '' %>" required>
            <% if (errors && errors.name) { %><div class="form-error"><%= errors.name %></div><% } %>
          </div>
          <div class="form-group <%= errors && errors.email ? 'field-invalid' : '' %>">
            <label for="email">Work email</label>
            <input type="email" id="email" name="email" value="<%= formData.email || '' %>" required>
            <% if (errors && errors.email) { %><div class="form-error"><%= errors.email %></div><% } %>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group <%= errors && errors.password ? 'field-invalid' : '' %>">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" minlength="8" required>
          </div>
          <div class="form-group <%= errors && errors.password ? 'field-invalid' : '' %>">
            <label for="confirmPassword">Confirm password</label>
            <input type="password" id="confirmPassword" name="confirmPassword" minlength="8" required>
            <% if (errors && errors.password) { %><div class="form-error"><%= errors.password %></div><% } %>
          </div>
        </div>

        <fieldset>
          <legend>Company</legend>
          <div class="form-group">
            <label class="checkbox-row"><input type="radio" name="companyMode" value="existing" checked> My company already has a QuanTech account</label>
            <select name="existingCompany" class="mt-sm">
              <option value="">Select your company&hellip;</option>
              <% companies.forEach(function(c) { %>
                <option value="<%= c.name %>" <%= formData.existingCompany === c.name ? 'selected' : '' %>><%= c.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label class="checkbox-row"><input type="radio" name="companyMode" value="new"> My company is new to QuanTech</label>
            <input type="text" name="newCompanyName" class="mt-sm" placeholder="Company name" value="<%= formData.newCompanyName || '' %>">
          </div>
          <% if (errors && errors.company) { %><div class="form-error"><%= errors.company %></div><% } %>
        </fieldset>

        <div class="form-row">
          <div class="form-group">
            <label for="department">Your department <span class="text-muted">(optional)</span></label>
            <input type="text" id="department" name="department" value="<%= formData.department || '' %>">
          </div>
          <div class="form-group">
            <label for="phone">Phone <span class="text-muted">(optional)</span></label>
            <input type="tel" id="phone" name="phone" value="<%= formData.phone || '' %>">
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-block">Create account</button>
      </form>

      <p class="auth-footer-note">Already have an account? <a href="/login" class="card-link">Sign in</a></p>
    </div>
  </div>
</div>
<script src="/js/main.js"></script>
</body>
</html>
