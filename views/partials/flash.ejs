<% if (locals.flash) { %>
  <div class="alert alert-<%= flash.type === 'error' ? 'error' : (flash.type === 'info' ? 'info' : 'success') %>" role="alert">
    <% if (flash.type === 'error') { %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><line x1="12" y1="8" x2="12" y2="13"/><circle cx="12" cy="16.5" r="0.6" fill="currentColor" stroke="none"/></svg>
    <% } else { %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/></svg>
    <% } %>
    <span><%= flash.message %></span>
  </div>
<% } %>
