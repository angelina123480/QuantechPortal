<%
  var verb = 'updated';
  if (item.type === 'created') verb = 'submitted a new ticket';
  else if (item.type === 'reply') verb = item.internal ? 'added an internal note on' : 'replied on';
  else if (item.type === 'note') verb = 'added an internal note on';
  else if (item.type === 'status_change') verb = 'changed status to ' + item.toStatus + ' on';
  else if (item.type === 'priority_change') verb = 'changed priority to ' + item.toPriority + ' on';
  else if (item.type === 'assigned') verb = (item.message && item.message.startsWith('Unassigned')) ? 'unassigned' : 'assigned a technician to';
%>
<div class="activity-item">
  <div class="activity-icon">
    <% if (item.type === 'created') { %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
    <% } else if (item.type === 'reply' || item.type === 'note') { %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
    <% } else if (item.type === 'assigned') { %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.5-7 8-7s8 3 8 7"/></svg>
    <% } else { %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
    <% } %>
  </div>
  <div>
    <div class="activity-text">
      <strong><%= item.authorName %></strong> <%= verb %>
      <a href="/tickets/<%= item.ticket.id %>"><%= item.ticket.ticketNumber %></a>
    </div>
    <div class="activity-time"><%= new Date(item.timestamp).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %></div>
  </div>
</div>
