PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string-in-production
NODE_ENV=development

# Postgres connection (e.g. from Neon). Pooled connection for the app itself;
# unpooled is used by the migrate/seed scripts.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require

# Vercel Blob (ticket attachment storage)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx

# SMTP (optional — password-reset links and notification emails). If unset,
# emails are logged to the server console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=QuanTech Support <no-reply@quantech.example>
